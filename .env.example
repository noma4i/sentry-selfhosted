COMPOSE_PROJECT_NAME=sentry-local
RELAY_IMAGE=ghcr.io/getsentry/relay:26.3.1
SENTRY_BIND=9000
SENTRY_DKIM_SELECTOR=mail
SENTRY_EVENT_RETENTION_DAYS=30
SENTRY_IMAGE=ghcr.io/getsentry/sentry:26.3.1
SENTRY_MAIL_HOST=example.com
SENTRY_MAIL_HOSTNAME=sentry.example.com
SENTRY_PUBLIC_URL=https://sentry.example.com
SENTRY_SYSTEM_SECRET_KEY=<generate: sentry config generate-secret-key>
SENTRY_TASKWORKER_CONCURRENCY=1
SNUBA_IMAGE=ghcr.io/getsentry/snuba:26.3.1
TASKBROKER_IMAGE=ghcr.io/getsentry/taskbroker:26.3.1
